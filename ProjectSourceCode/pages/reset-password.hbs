<div class="container mt-4" style="max-width: 500px;">
  <h2>Choose a new password</h2>
  {{#each errors}}<div class="alert alert-danger">{{this}}</div>{{/each}}
  <form action="/reset-password/{{token}}" method="POST">
    <input class="form-control mb-2" type="password" name="password" placeholder="New password" required>
    <input class="form-control mb-2" type="password" name="confirm_password" placeholder="Confirm new password" required>
    <button class="btn btn-primary">Reset password</button>
  </form>
</div>