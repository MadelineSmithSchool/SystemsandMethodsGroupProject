<main class="templates-page">
  <header class="templates-page-header">
      <div>
          <h1>My Characters</h1>
      </div>
      <a href="/characters/create" class="btn btn--primary">Create new character</a>
  </header>
  {{#if error}}<p class="error" data-list-error>{{error}}</p>{{/if}}
  {{> list-controls action="/characters" label="Search your characters" placeholder="Enter character name"}}
  <div class="templates-grid" data-list-results>
    {{#each characters}}
      <article class="template-card" data-list-item>
        <h2><a href="/characters/{{character_id}}">{{character_name}}</a></h2>
        {{#if template_name}}<p><strong>Template:</strong> {{template_name}}</p>{{/if}}
        <div class="template-card-actions">
            <a href="/characters/{{character_id}}" class="character-card-open">View character</a>
        </div>
      </article>
    {{else}}
      {{#if list.search}}
        <p>None of your characters match "{{list.search}}".</p>
      {{else}}
        <p>You haven't made any characters yet.</p>
      {{/if}}
    {{/each}}
  </div>
</main>
