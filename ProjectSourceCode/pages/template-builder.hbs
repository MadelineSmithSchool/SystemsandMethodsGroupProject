{{!-- Temporary prototype: this browser-only builder may be replaced if the team chooses a better design. --}}
<main class="sheet-studio" data-sheet-studio data-mode="developer">
    <header class="studio-header">
        <div>
            <p class="prototype-flag">temporary design mockup (though keep functionality thats already here)</p>
            <h1>RPG Templates Studio</h1>
            <p class="studio-subtitle">Build the sheet, then switch to Playtest and try it as a player.</p>
        </div>
        <div class="studio-header-actions">
            <div class="studio-view-switch" role="tablist" aria-label="Studio view">
                <button type="button" role="tab" aria-selected="true" data-view-button="developer">Developer</button>
                <button type="button" role="tab" aria-selected="false" data-view-button="playtest">Playtest</button>
            </div>
            <button class="btn" type="button">Download .json</button>
            <button class="btn" type="button">Save draft</button>
            <button class="btn studio-publish" type="button">Publish</button>
        </div>
    </header>

    <div class="prototype-note">
        <p><strong>WIP:</strong> this design is a mockup in desperate need of improvement, but this is generally how i wanted it to work THIS IS NOT CONNECTED TO THE DATABASE, SAVE AND PUBLISH AND DOWNLOAD DO NOTHING.</p>
        <ul>
            <li>connect to db(save should save as private, publish should change to public or unlisted as the status prolly)</li>
            <li>make the usability more fluid(like its stuck on the grid right now, but maybe outline where it will drop but still follow the mouse to look better)</li>
            <li>add more templates of pre connected modules so that users can see how to make stuff(ill try to add a few)</li>
            <li>fix bugs like rolling 100 dice goes past the bounds, so need scrolling inside modules</li>
            <li>add colour picker to pallet so that devs or even players can customize how their sheet looks without changing functionality.</li>
            <li>overall just add more module settings, and maybe put the settings over the modules when clicking edit</li>
            <li>save presets to the database</li>
            <li>change module palette icons to be images that look good</li>
        </ul>
    </div>

    <div class="studio-sheet-meta">
        <label for="sheet-name">Sheet name<input id="sheet-name" type="text" maxlength="50" placeholder="E.g. Fateshift Character Sheet"></label>
        <label for="sheet-description">Description<input id="sheet-description" type="text" maxlength="255" placeholder="Optional game or sheet notes"></label>
    </div>

    <div class="studio-layout">
        <aside class="studio-sidebar" data-developer-only>
            <section class="studio-panel module-palette" aria-labelledby="module-palette-title">
                <h2 id="module-palette-title">Module palette</h2>
                <p>Click to add, or drag a module onto the sheet.</p>
                <div class="studio-palette-grid">
                    <button class="module-tool" type="button" data-module-tool="number"><span class="module-tool-icon">123</span>Number</button>
                    <button class="module-tool" type="button" data-module-tool="text"><span class="module-tool-icon">Aa</span>Text</button>
                    <button class="module-tool" type="button" data-module-tool="dice"><span class="module-tool-icon">d20</span>Dice</button>
                    <button class="module-tool" type="button" data-module-tool="checkbox"><span class="module-tool-icon">[x]</span>Checkbox</button>
                    <button class="module-tool" type="button" data-module-tool="notes"><span class="module-tool-icon">TXT</span>Notes</button>
                    <button class="module-tool" type="button" data-module-tool="group"><span class="module-tool-icon">[]</span>Group</button>
                </div>
            </section>

            <section class="studio-panel inspector-panel" aria-labelledby="inspector-title">
                <h2 id="inspector-title">Module settings</h2>
                <div data-inspector><p class="studio-muted">Select Edit on a module to change its settings and inputs.</p></div>
            </section>

            <section class="studio-panel presets-panel" aria-labelledby="module-presets-title">
                <h2 id="module-presets-title">Module presets</h2>
                <p>Start with connected modules or save a canvas selection as a preset.</p>
                <div class="module-preset-list" data-preset-list>
                    <button class="module-preset" type="button" data-load-preset="ability-check">Ability check</button>
                    <button class="module-preset" type="button" data-load-preset="advantage-attack">Advantage attack</button>
                </div>
                <p class="studio-muted" data-preset-selection aria-live="polite">Select modules by dragging across the canvas.</p>
                <label class="inspector-field" for="preset-name">Preset name
                    <input id="preset-name" type="text" maxlength="40" placeholder="My preset">
                </label>
                <button class="btn module-save-preset" type="button" data-save-preset disabled>Save selected modules</button>
            </section>

        </aside>

        <section class="studio-workspace" aria-label="Character sheet workspace">
            <div class="workspace-heading">
                <h2 data-workspace-title>Developer canvas</h2>
                <p data-workspace-help>Snap modules into the grid. Drag modules into a group to keep related fields together.</p>
            </div>
            <div class="studio-canvas" data-layout-canvas data-root-canvas role="region" aria-label="Character sheet canvas" tabindex="0">
                <p class="canvas-empty-state" data-empty-state>Start with a module from the palette.</p>
            </div>
        </section>
    </div>
</main>

<script>
    (function () {
        var studio = document.querySelector('[data-sheet-studio]');
        if (!studio) return;

        var rootCanvas = studio.querySelector('[data-root-canvas]');
        var inspector = studio.querySelector('[data-inspector]');
        var emptyState = studio.querySelector('[data-empty-state]');
        var modules = [];
        var savedPresets = [];
        var selectedModuleIds = [];
        var nextId = 1;
        var selectedId = null;
        var mode = 'developer';
        var activeDrag = null;
        var suppressToolClick = false;
        var names = { number: 'Number', text: 'Text', dice: 'Dice', checkbox: 'Checkbox', notes: 'Notes', group: 'Group' };
        var numericSettings = ['value', 'count', 'sides', 'uncheckedValue', 'checkedValue', 'keepHighest'];

        function placementsOverlap(first, second) {
            return first.col < second.col + second.colSpan && first.col + first.colSpan > second.col &&
                first.row < second.row + second.rowSpan && first.row + first.rowSpan > second.row;
        }

        // find nearest free area
        function findOpenPlacement(list, columns, colSpan, rowSpan, preferred, ignoreId) {
            var lastRow = Math.max(24, preferred.row + 12);
            list.forEach(function (item) { lastRow = Math.max(lastRow, item.row + item.rowSpan + 8); });
            var best = null;
            var bestDistance = Infinity;
            for (var row = 1; row <= lastRow; row += 1) {
                for (var col = 1; col <= columns - colSpan + 1; col += 1) {
                    var candidate = { col: col, row: row, colSpan: colSpan, rowSpan: rowSpan };
                    if (list.some(function (item) { return item.id !== ignoreId && placementsOverlap(candidate, item); })) continue;
                    var distance = Math.abs(col - preferred.col) + Math.abs(row - preferred.row) * 2;
                    if (distance < bestDistance) {
                        best = candidate;
                        bestDistance = distance;
                    }
                }
            }
            return best || { col: 1, row: lastRow + 1, colSpan: colSpan, rowSpan: rowSpan };
        }

        // apply free grid placement
        function placeAtNearestOpen(list, module, columns, preferred) {
            var placement = findOpenPlacement(list, columns, module.colSpan, module.rowSpan, preferred, module.id);
            module.col = placement.col;
            module.row = placement.row;
            module.colSpan = placement.colSpan;
            module.rowSpan = placement.rowSpan;
        }

        // create and select module
        function createModule(type, parentList, deferRefresh) {
            var siblings = parentList || modules;
            var columns = siblings === modules ? 12 : 6;
            var colSpan = Math.min(4, columns);
            var placement = findOpenPlacement(siblings, columns, colSpan, 3, {
                col: 1 + (siblings.length % 3) * 4,
                row: 1 + Math.floor(siblings.length / 3) * 3
            });
            var module = {
                id: String(nextId++), type: type, name: names[type],
                col: placement.col, row: placement.row,
                colSpan: placement.colSpan, rowSpan: placement.rowSpan, value: type === 'number' ? '10' : '', checked: false,
                count: 1, countSource: '', sides: 20, sidesSource: '', source: '', modifiers: [], rollResult: '', children: [],
                uncheckedValue: 0, checkedValue: 1, keepHighest: 0, keepHighestSource: '', bonusSource: ''
            };
            siblings.push(module);
            selectedId = module.id;
            if (!deferRefresh) refresh();
            return module;
        }

        function findModuleEntry(id, list, parent) {
            var collection = list || modules;
            for (var index = 0; index < collection.length; index += 1) {
                var module = collection[index];
                if (module.id === id) return { module: module, list: collection, parent: parent || null, index: index };
                var nested = findModuleEntry(id, module.children, module);
                if (nested) return nested;
            }
            return null;
        }

        function findModule(id) {
            var entry = findModuleEntry(id);
            return entry && entry.module;
        }

        // flatten nested module groups
        function flatten(list, output) {
            (list || modules).forEach(function (module) {
                output.push(module);
                flatten(module.children, output);
            });
            return output;
        }

        function valueModules() {
            return flatten(modules, []).filter(function (module) { return module.type !== 'group'; });
        }

        function checkboxModules() {
            return flatten(modules, []).filter(function (module) { return module.type === 'checkbox'; });
        }

        function clonePresetModules(presetModules) {
            var clones = JSON.parse(JSON.stringify(presetModules));
            var idMap = {};
            function assignIds(list) {
                list.forEach(function (module) {
                    idMap[module.id] = String(nextId++);
                    module.id = idMap[module.id];
                    module.rollResult = '';
                    assignIds(module.children || []);
                });
            }
            function remapReferences(list) {
                list.forEach(function (module) {
                    ['source', 'countSource', 'sidesSource', 'keepHighestSource', 'bonusSource'].forEach(function (setting) {
                        if (module[setting]) module[setting] = idMap[module[setting]] || '';
                    });
                    module.modifiers = (module.modifiers || []).filter(function (modifier) {
                        return idMap[modifier.source];
                    }).map(function (modifier) {
                        return { source: idMap[modifier.source], amount: modifier.amount };
                    });
                    remapReferences(module.children || []);
                });
            }
            assignIds(clones);
            remapReferences(clones);
            return clones;
        }

        function addConnectedPreset(presetName) {
            var isAttackRoll = presetName === 'advantage-attack';
            var checkbox = createModule('checkbox', modules, true);
            checkbox.name = 'Proficient';

            var modifier = createModule('number', modules, true);
            modifier.name = isAttackRoll ? 'Attack modifier' : 'Ability modifier';
            modifier.value = '0';
            modifier.modifiers = [{ source: checkbox.id, amount: 2 }];

            var dice = createModule('dice', modules, true);
            dice.name = isAttackRoll ? 'Attack roll' : 'Ability check';
            if (isAttackRoll) {
                dice.count = 2;
                dice.keepHighest = 1;
            }
            dice.bonusSource = modifier.id;
            selectedId = dice.id;
            selectedModuleIds = [];
            refresh();
        }

        function renderSavedPresets() {
            var list = studio.querySelector('[data-preset-list]');
            list.querySelectorAll('[data-saved-preset]').forEach(function (button) { button.remove(); });
            savedPresets.forEach(function (preset, index) {
                var button = document.createElement('button');
                button.className = 'module-preset';
                button.type = 'button';
                button.dataset.savedPreset = index;
                button.textContent = preset.name;
                list.appendChild(button);
            });
        }

        function updatePresetSelection() {
            var count = selectedModuleIds.length;
            var status = studio.querySelector('[data-preset-selection]');
            status.textContent = count ? count + (count === 1 ? ' module selected.' : ' modules selected.') : 'Select modules by dragging across the canvas.';
            studio.querySelector('[data-save-preset]').disabled = count === 0;
            rootCanvas.querySelectorAll('[data-sheet-module]').forEach(function (element) {
                element.classList.toggle('is-multi-selected', selectedModuleIds.includes(element.dataset.sheetModule));
            });
        }

        // populate linked value choices
        function selectOptions(select, items, selected, emptyLabel) {
            var empty = document.createElement('option');
            empty.value = '';
            empty.textContent = emptyLabel;
            select.appendChild(empty);
            items.forEach(function (item) {
                var option = document.createElement('option');
                option.value = item.id;
                option.textContent = item.name || names[item.type];
                option.selected = item.id === selected;
                select.appendChild(option);
            });
        }

        function field(labelText, control) {
            var label = document.createElement('label');
            label.className = 'inspector-field';
            label.append(document.createTextNode(labelText), control);
            return label;
        }

        function inputControl(type, value, min, max) {
            var control = document.createElement('input');
            control.type = type;
            control.value = value;
            if (min !== undefined) control.min = min;
            if (max !== undefined) control.max = max;
            return control;
        }

        function settingInput(label, setting, value, min, max) {
            var input = inputControl(typeof value === 'number' ? 'number' : 'text', value, min, max);
            input.dataset.setting = setting;
            inspector.appendChild(field(label, input));
            return input;
        }

        function settingSelect(label, items, selected, emptyLabel, setting) {
            var select = document.createElement('select');
            selectOptions(select, items, selected, emptyLabel);
            select.dataset.setting = setting;
            inspector.appendChild(field(label, select));
        }

        // show selected module settings
        function renderInspector() {
            inspector.replaceChildren();
            var module = findModule(selectedId);
            if (!module) {
                var empty = document.createElement('p');
                empty.className = 'studio-muted';
                empty.textContent = 'Select Edit on a module to change its settings and inputs.';
                inspector.appendChild(empty);
                return;
            }

            var nameInput = settingInput('Module name', 'name', module.name);
            nameInput.maxLength = 40;

            if (module.type !== 'group' && module.type !== 'dice') {
                settingSelect('Input from', valueModules().filter(function (item) { return item.id !== module.id; }), module.source, 'Player enters this value', 'source');
            }

            if (module.type === 'number' && !module.source) {
                settingInput('Starting value', 'value', Number(module.value || 0));
            }

            if (module.type === 'checkbox' && !module.source) {
                settingInput('Value when not checked', 'uncheckedValue', module.uncheckedValue);
                settingInput('Value when checked', 'checkedValue', module.checkedValue);
            }

            if (module.type === 'number') {
                var modifierHeading = document.createElement('strong');
                modifierHeading.textContent = 'Conditional changes';
                inspector.appendChild(modifierHeading);
                var modifierHelp = document.createElement('p');
                modifierHelp.className = 'studio-muted';
                modifierHelp.textContent = 'Change this value when a checkbox is on.';
                inspector.appendChild(modifierHelp);
                module.modifiers.forEach(function (modifier, index) {
                    var row = document.createElement('div');
                    row.className = 'module-modifier';
                    row.dataset.modifierIndex = index;
                    row.dataset.moduleId = module.id;
                    var checkboxSelect = document.createElement('select');
                    selectOptions(checkboxSelect, checkboxModules(), modifier.source, 'Choose a checkbox');
                    checkboxSelect.dataset.modifierSetting = 'source';
                    var amount = inputControl('number', modifier.amount, -99, 99);
                    amount.dataset.modifierSetting = 'amount';
                    row.append(field('When checked', checkboxSelect), field('Change by', amount));
                    var remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'btn module-modifier-remove';
                    remove.dataset.removeModifier = index;
                    remove.textContent = 'Remove';
                    row.appendChild(remove);
                    inspector.appendChild(row);
                });
                var addModifier = document.createElement('button');
                addModifier.type = 'button';
                addModifier.className = 'btn module-add-modifier';
                addModifier.dataset.addModifier = module.id;
                addModifier.textContent = 'Add checkbox change';
                inspector.appendChild(addModifier);
            }

            if (module.type === 'dice') {
                var sources = valueModules().filter(function (item) { return item.id !== module.id; });
                settingInput('Number of dice', 'count', module.count, 1, 100);
                settingInput('Die sides', 'sides', module.sides, 2, 1000);
                settingInput('Keep highest', 'keepHighest', module.keepHighest, 0, 100);
                settingSelect('Count from', sources, module.countSource, 'Fixed dice count', 'countSource');
                settingSelect('Sides from', sources, module.sidesSource, 'Fixed die sides', 'sidesSource');
                settingSelect('Keep highest from', sources, module.keepHighestSource, 'Use fixed keep highest', 'keepHighestSource');
                settingSelect('Add number value', sources, module.bonusSource, 'No bonus', 'bonusSource');
            }

            if (module.type === 'group') {
                var groupHint = document.createElement('p');
                groupHint.className = 'studio-muted';
                groupHint.textContent = 'Drop other modules inside this group to organize related fields.';
                inspector.appendChild(groupHint);
            }
        }

        // read responsive grid columns
        function layoutColumns(layout) {
            return Number(getComputedStyle(layout).getPropertyValue('--layout-columns').trim()) || 12;
        }

        // apply module grid position
        function setPlacement(element, module, layout) {
            var columns = layoutColumns(layout);
            module.colSpan = Math.min(module.colSpan, columns);
            module.col = Math.max(1, Math.min(columns - module.colSpan + 1, module.col));
            element.style.gridColumn = module.col + ' / span ' + module.colSpan;
            element.style.gridRow = module.row + ' / span ' + module.rowSpan;
        }

        // build module controls
        function createPlayableControl(module) {
            var body = document.createElement('div');
            body.className = 'module-body';
            if (module.type === 'group') {
                var groupCanvas = document.createElement('div');
                groupCanvas.className = 'group-canvas';
                groupCanvas.dataset.layoutCanvas = '';
                groupCanvas.dataset.groupCanvas = module.id;
                renderModules(groupCanvas, module.children, false);
                body.appendChild(groupCanvas);
                return body;
            }

            if (module.type === 'dice') {
                var formula = document.createElement('p');
                formula.className = 'dice-formula';
                formula.dataset.diceFormula = module.id;
                formula.textContent = diceFormula(module);
                var rollButton = document.createElement('button');
                rollButton.type = 'button';
                rollButton.className = 'btn dice-roll-button';
                rollButton.dataset.rollModule = module.id;
                rollButton.textContent = 'Roll';
                var result = document.createElement('output');
                result.className = 'dice-result';
                result.textContent = module.rollResult || '-';
                body.append(formula, rollButton, result);
                return body;
            }

            if (module.source) {
                var output = document.createElement('output');
                output.className = 'module-output';
                output.dataset.sourceValue = module.id;
                output.textContent = String(resolveValue(module.id, {}));
                body.appendChild(output);
                return body;
            }

            if (module.type === 'checkbox') {
                var checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.checked = module.checked;
                checkbox.dataset.moduleChecked = module.id;
                checkbox.setAttribute('aria-label', module.name);
                body.appendChild(checkbox);
                return body;
            }

            var input = module.type === 'notes' ? document.createElement('textarea') : document.createElement('input');
            if (module.type !== 'notes') input.type = module.type === 'number' ? 'number' : 'text';
            input.value = module.value || '';
            input.placeholder = module.type === 'notes' ? 'Write notes' : module.type === 'number' ? '0' : 'Enter text';
            input.dataset.moduleValue = module.id;
            input.setAttribute('aria-label', module.name);
            body.appendChild(input);
            if (module.type === 'number') {
                var effective = document.createElement('output');
                effective.className = 'number-effective';
                effective.dataset.effectiveNumber = module.id;
                body.appendChild(effective);
            }
            return body;
        }

        // render grouped modules recursively
        function renderModules(layout, list, root) {
            list.forEach(function (module) {
                var card = document.createElement('article');
                card.className = 'sheet-module' + (module.id === selectedId ? ' is-selected' : '') +
                    (selectedModuleIds.includes(module.id) ? ' is-multi-selected' : '');
                card.dataset.sheetModule = module.id;
                card.dataset.moduleType = module.type;
                setPlacement(card, module, layout);

                var header = document.createElement('header');
                header.className = 'sheet-module-header';
                var move = document.createElement('button');
                move.type = 'button';
                move.className = 'module-move-handle';
                move.dataset.moveModule = '';
                move.textContent = 'Move';
                move.setAttribute('aria-label', 'Move ' + module.name);
                var title = document.createElement('strong');
                title.dataset.moduleTitle = '';
                title.textContent = module.name;
                header.append(move, title);
                if (mode === 'developer') {
                    var edit = document.createElement('button');
                    edit.type = 'button';
                    edit.className = 'module-edit';
                    edit.dataset.editModule = module.id;
                    edit.textContent = 'Edit';
                    header.appendChild(edit);
                    var remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'module-remove';
                    remove.dataset.removeModule = module.id;
                    remove.textContent = 'Remove';
                    header.appendChild(remove);
                }
                
                card.appendChild(header);

                if (mode === 'developer' && module.type !== 'group') {
                    var devSummary = document.createElement('p');
                    devSummary.className = 'module-dev-summary';
                    devSummary.textContent = module.type === 'dice' ? 'Roll output' : module.source ? 'Linked input' : 'Player input';
                    card.appendChild(devSummary);
                }
                var body = createPlayableControl(module);
                card.appendChild(body);

                if (mode === 'developer') {
                    var resize = document.createElement('button');
                    resize.type = 'button';
                    resize.className = 'module-resize-handle';
                    resize.dataset.resizeModule = '';
                    resize.setAttribute('aria-label', 'Resize ' + module.name);
                    card.appendChild(resize);
                }
                layout.appendChild(card);
            });
            if (root) emptyState.hidden = list.length > 0;
        }

        // redraw the root canvas
        function renderCanvas() {
            rootCanvas.querySelectorAll('[data-sheet-module]').forEach(function (element) { element.remove(); });
            renderModules(rootCanvas, modules, true);
        }

        // compute linked field values
        function resolveValue(id, visited) {
            var module = findModule(id);
            if (!module || module.type === 'group' || visited[id]) return '';
            visited[id] = true;
            var value;
            if (module.type === 'dice') {
                var match = module.rollResult.match(/(?:=\s*)?(-?\d+)$/);
                value = match ? Number(match[1]) : 0;
            } else if (module.source) {
                value = resolveValue(module.source, visited);
            } else if (module.type === 'number') {
                value = Number(module.value || 0);
            } else if (module.type === 'checkbox') {
                value = Number(module.checked ? module.checkedValue : module.uncheckedValue);
            } else {
                value = module.value || '';
            }
            if (module.type === 'number') {
                value = Number(value) || 0;
                module.modifiers.forEach(function (modifier) {
                    var source = findModule(modifier.source);
                    if (source && Boolean(resolveValue(source.id, visited))) value += Number(modifier.amount || 0);
                });
            }
            delete visited[id];
            return value;
        }

        function diceCount(module) {
            var linked = module.countSource ? Number(resolveValue(module.countSource, {})) : Number(module.count || 1);
            return Math.max(1, Math.min(100, Math.floor(linked || 1)));
        }

        function diceSides(module) {
            var linked = module.sidesSource ? Number(resolveValue(module.sidesSource, {})) : Number(module.sides || 20);
            return Math.max(2, Math.min(1000, Math.floor(linked || 20)));
        }

        function diceKeepHighest(module) {
            var linked = module.keepHighestSource ? Number(resolveValue(module.keepHighestSource, {})) : Number(module.keepHighest || 0);
            return Math.max(0, Math.min(diceCount(module), Math.floor(linked || 0)));
        }

        function diceBonus(module) {
            return module.bonusSource ? Number(resolveValue(module.bonusSource, {})) || 0 : 0;
        }

        function diceFormula(module) {
            var count = diceCount(module);
            var keepHighest = diceKeepHighest(module);
            var formula = count + 'd' + diceSides(module) + (keepHighest ? 'kh' + keepHighest : '');
            var bonus = diceBonus(module);
            if (bonus) formula += bonus > 0 ? ' +' + bonus : ' ' + bonus;
            return formula;
        }

        // sync derived values
        function updateLiveValues() {
            studio.querySelectorAll('[data-module-value]').forEach(function (input) {
                var module = findModule(input.dataset.moduleValue);
                if (module && input !== document.activeElement) input.value = module.value || '';
            });
            studio.querySelectorAll('[data-source-value]').forEach(function (output) {
                output.textContent = String(resolveValue(output.dataset.sourceValue, {}));
            });
            studio.querySelectorAll('[data-effective-number]').forEach(function (output) {
                output.textContent = 'Effective: ' + resolveValue(output.dataset.effectiveNumber, {});
            });
            studio.querySelectorAll('[data-dice-formula]').forEach(function (formula) {
                var module = findModule(formula.dataset.diceFormula);
                if (module) formula.textContent = diceFormula(module);
            });
        }

        // redraw editor and inspector
        function refresh() {
            renderCanvas();
            renderInspector();
            updateLiveValues();
        }

        function removeModule(id) {
            var entry = findModuleEntry(id);
            if (entry) entry.list.splice(entry.index, 1);
        }

        // find canvas under pointer
        function canvasForPoint(x, y) {
            var target = document.elementFromPoint(x, y);
            var groupCanvas = target && target.closest('[data-group-canvas]');
            if (groupCanvas) return { element: groupCanvas, owner: findModule(groupCanvas.dataset.groupCanvas) };
            if (target && rootCanvas.contains(target)) return { element: rootCanvas, owner: null };
            return null;
        }

        // snap movement and resizing
        function setSnappedPlacement(module, layout, start, x, y, resize) {
            var columns = layoutColumns(layout);
            var bounds = layout.getBoundingClientRect();
            var columnStep = bounds.width / columns;
            var rowStep = parseFloat(getComputedStyle(layout).gridAutoRows) || 64;
            var deltaColumns = Math.round((x - start.x) / columnStep);
            var deltaRows = Math.round((y - start.y) / rowStep);
            if (resize) {
                module.colSpan = Math.max(2, Math.min(columns - module.col + 1, start.colSpan + deltaColumns));
                module.rowSpan = Math.max(2, start.rowSpan + deltaRows);
            } else {
                module.col = Math.max(1, Math.min(columns - module.colSpan + 1, start.col + deltaColumns));
                module.row = Math.max(1, start.row + deltaRows);
            }
        }

        // start canvas drag
        studio.addEventListener('pointerdown', function (event) {
            var tool = event.target.closest('[data-module-tool]');
            if (tool && mode === 'developer') {
                activeDrag = { kind: 'palette', pointerId: event.pointerId, type: tool.dataset.moduleTool, tool: tool, startX: event.clientX, startY: event.clientY, dragged: false };
                tool.setPointerCapture(event.pointerId);
                return;
            }

            if (mode === 'developer' && rootCanvas.contains(event.target) && !event.target.closest('[data-sheet-module]')) {
                selectedModuleIds = [];
                selectedId = null;
                activeDrag = {
                    kind: 'selection', pointerId: event.pointerId,
                    startX: event.clientX, startY: event.clientY
                };
                activeDrag.marquee = document.createElement('div');
                activeDrag.marquee.className = 'module-selection-marquee';
                rootCanvas.appendChild(activeDrag.marquee);
                rootCanvas.setPointerCapture(event.pointerId);
                rootCanvas.focus();
                updatePresetSelection();
                renderInspector();
                event.preventDefault();
                return;
            }

            var move = event.target.closest('[data-move-module]');
            var resize = event.target.closest('[data-resize-module]');
            if ((!move && !resize) || mode !== 'developer') return;
            var element = event.target.closest('[data-sheet-module]');
            var module = findModule(element.dataset.sheetModule);
            var layout = element.parentElement.closest('[data-layout-canvas]');
            (move || resize).setPointerCapture(event.pointerId);
            activeDrag = {
                kind: 'module', pointerId: event.pointerId, module: module, element: element, layout: layout,
                resize: !!resize,
                start: { x: event.clientX, y: event.clientY, col: module.col, row: module.row, colSpan: module.colSpan, rowSpan: module.rowSpan }
            };
            event.preventDefault();
        });

        // update active drag placement
        studio.addEventListener('pointermove', function (event) {
            if (!activeDrag || activeDrag.pointerId !== event.pointerId) return;
            if (activeDrag.kind === 'palette') {
                if (Math.hypot(event.clientX - activeDrag.startX, event.clientY - activeDrag.startY) > 6) {
                    activeDrag.dragged = true;
                    activeDrag.tool.classList.add('is-dragging');
                    event.preventDefault();
                }
                return;
            }
            if (activeDrag.kind === 'selection') {
                var selectionBounds = {
                    left: Math.min(activeDrag.startX, event.clientX),
                    right: Math.max(activeDrag.startX, event.clientX),
                    top: Math.min(activeDrag.startY, event.clientY),
                    bottom: Math.max(activeDrag.startY, event.clientY)
                };
                var canvasBounds = rootCanvas.getBoundingClientRect();
                activeDrag.marquee.style.left = selectionBounds.left - canvasBounds.left + rootCanvas.scrollLeft + 'px';
                activeDrag.marquee.style.top = selectionBounds.top - canvasBounds.top + rootCanvas.scrollTop + 'px';
                activeDrag.marquee.style.width = selectionBounds.right - selectionBounds.left + 'px';
                activeDrag.marquee.style.height = selectionBounds.bottom - selectionBounds.top + 'px';
                selectedModuleIds = [];
                Array.prototype.forEach.call(rootCanvas.children, function (element) {
                    if (!element.matches('[data-sheet-module]')) return;
                    var bounds = element.getBoundingClientRect();
                    if (bounds.left < selectionBounds.right && bounds.right > selectionBounds.left &&
                        bounds.top < selectionBounds.bottom && bounds.bottom > selectionBounds.top) {
                        selectedModuleIds.push(element.dataset.sheetModule);
                    }
                });
                updatePresetSelection();
                event.preventDefault();
                return;
            }
            var owner = findModuleEntry(activeDrag.module.id);
            var previous = { col: activeDrag.module.col, row: activeDrag.module.row, colSpan: activeDrag.module.colSpan, rowSpan: activeDrag.module.rowSpan };
            setSnappedPlacement(activeDrag.module, activeDrag.layout, activeDrag.start, event.clientX, event.clientY, activeDrag.resize);
            if (owner && owner.list.some(function (item) { return item !== activeDrag.module && placementsOverlap(activeDrag.module, item); })) {
                activeDrag.module.col = previous.col;
                activeDrag.module.row = previous.row;
                activeDrag.module.colSpan = previous.colSpan;
                activeDrag.module.rowSpan = previous.rowSpan;
                return;
            }
            setPlacement(activeDrag.element, activeDrag.module, activeDrag.layout);
        });

        // finish drop or reparent
        studio.addEventListener('pointerup', function (event) {
            if (!activeDrag || activeDrag.pointerId !== event.pointerId) return;
            var drag = activeDrag;
            activeDrag = null;
            if (drag.kind === 'palette') {
                drag.tool.classList.remove('is-dragging');
                if (!drag.dragged) return;
                suppressToolClick = true;
                window.setTimeout(function () { suppressToolClick = false; }, 50);
                var destination = canvasForPoint(event.clientX, event.clientY);
                if (!destination) return;
                var list = destination.owner ? destination.owner.children : modules;
                var module = createModule(drag.type, list, true);
                var pointBounds = destination.element.getBoundingClientRect();
                var cols = layoutColumns(destination.element);
                placeAtNearestOpen(list, module, cols, {
                    col: Math.max(1, Math.min(cols - module.colSpan + 1, Math.floor((event.clientX - pointBounds.left) / (pointBounds.width / cols)) + 1)),
                    row: Math.max(1, Math.floor((event.clientY - pointBounds.top) / (parseFloat(getComputedStyle(destination.element).gridAutoRows) || 64)) + 1)
                });
                refresh();
                return;
            }
            if (drag.kind === 'selection') {
                drag.marquee.remove();
                updatePresetSelection();
                return;
            }

            var drop = canvasForPoint(event.clientX, event.clientY);
            if (drop && drop.owner && drop.owner.id !== drag.module.id) {
                var owner = findModuleEntry(drag.module.id);
                if (owner && owner.parent !== drop.owner) {
                    owner.list.splice(owner.list.indexOf(drag.module), 1);
                    var groupColumns = layoutColumns(drop.element);
                    drag.module.colSpan = Math.min(drag.module.colSpan, groupColumns);
                    placeAtNearestOpen(drop.owner.children, drag.module, groupColumns, { col: 1, row: 1 });
                    drop.owner.children.push(drag.module);
                    refresh();
                    return;
                }
            } else if (drop && !drop.owner) {
                var moduleOwner = findModuleEntry(drag.module.id);
                if (moduleOwner && moduleOwner.parent) {
                    moduleOwner.list.splice(moduleOwner.list.indexOf(drag.module), 1);
                    var rootColumns = layoutColumns(rootCanvas);
                    drag.module.colSpan = Math.min(4, rootColumns);
                    placeAtNearestOpen(modules, drag.module, rootColumns, { col: 1, row: 1 });
                    modules.push(drag.module);
                    refresh();
                    return;
                }
            }
            renderCanvas();
        });

        // restore canceled drag state
        studio.addEventListener('pointercancel', function (event) {
            if (!activeDrag || activeDrag.pointerId !== event.pointerId) return;
            if (activeDrag.kind === 'palette') {
                activeDrag.tool.classList.remove('is-dragging');
            } else if (activeDrag.kind === 'selection') {
                activeDrag.marquee.remove();
                selectedModuleIds = [];
                updatePresetSelection();
            } else {
                Object.assign(activeDrag.module, {
                    col: activeDrag.start.col,
                    row: activeDrag.start.row,
                    colSpan: activeDrag.start.colSpan,
                    rowSpan: activeDrag.start.rowSpan
                });
                renderCanvas();
            }
            activeDrag = null;
        });

        // handle studio actions
        studio.addEventListener('keydown', function (event) {
            if ((event.key !== 'Backspace' && event.key !== 'Delete') || mode !== 'developer') return;
            if (event.target.closest('input, textarea, select, [contenteditable="true"]')) return;

            var idsToDelete = selectedModuleIds.slice();
            if (!idsToDelete.length && selectedId && findModule(selectedId)) idsToDelete.push(selectedId);
            if (!idsToDelete.length) return;

            event.preventDefault();
            var prompt = idsToDelete.length === 1 ?
                'Do you want to delete the selected module?' :
                'Do you want to delete the selected modules?';
            if (!window.confirm(prompt)) return;

            idsToDelete.forEach(function (id) { removeModule(id); });
            selectedModuleIds = [];
            selectedId = null;
            refresh();
        });

        studio.addEventListener('click', function (event) {
            var viewButton = event.target.closest('[data-view-button]');
            if (viewButton) {
                mode = viewButton.dataset.viewButton;
                studio.dataset.mode = mode;
                selectedModuleIds = [];
                updatePresetSelection();
                studio.querySelectorAll('[data-view-button]').forEach(function (button) {
                    button.setAttribute('aria-selected', String(button === viewButton));
                });
                studio.querySelector('[data-workspace-title]').textContent = mode === 'developer' ? 'Developer canvas' : (studio.querySelector('#sheet-name').value || 'Character sheet');
                studio.querySelector('[data-workspace-help]').textContent = mode === 'developer' ? 'Snap modules into the grid. Drag modules into a group to keep related fields together.' : 'Enter values, toggle conditions, and roll dice to test the sheet.';
                refresh();
                return;
            }

            var presetButton = event.target.closest('[data-load-preset]');
            if (presetButton && mode === 'developer') {
                addConnectedPreset(presetButton.dataset.loadPreset);
                return;
            }

            var savedPresetButton = event.target.closest('[data-saved-preset]');
            if (savedPresetButton && mode === 'developer') {
                var preset = savedPresets[Number(savedPresetButton.dataset.savedPreset)];
                if (preset) {
                    var presetModules = clonePresetModules(preset.modules);
                    presetModules.forEach(function (module) {
                        module.colSpan = Math.min(module.colSpan, layoutColumns(rootCanvas));
                        placeAtNearestOpen(modules, module, layoutColumns(rootCanvas), { col: module.col, row: module.row });
                        modules.push(module);
                    });
                    selectedId = presetModules.length ? presetModules[presetModules.length - 1].id : null;
                    selectedModuleIds = [];
                    refresh();
                }
                return;
            }

            var savePreset = event.target.closest('[data-save-preset]');
            if (savePreset && mode === 'developer' && selectedModuleIds.length) {
                var selectedSet = {};
                selectedModuleIds.forEach(function (id) { selectedSet[id] = true; });
                var selectedModules = modules.filter(function (module) { return selectedSet[module.id]; });
                var presetNameInput = studio.querySelector('#preset-name');
                var presetName = presetNameInput.value.trim() || 'Preset ' + (savedPresets.length + 1);
                savedPresets.push({
                    name: presetName,
                    modules: JSON.parse(JSON.stringify(selectedModules))
                });
                presetNameInput.value = '';
                selectedModuleIds = [];
                renderSavedPresets();
                updatePresetSelection();
                return;
            }

            var tool = event.target.closest('[data-module-tool]');
            if (tool && mode === 'developer') {
                if (suppressToolClick) return;
                createModule(tool.dataset.moduleTool);
                return;
            }

            var remove = event.target.closest('[data-remove-module]');
            if (remove && mode === 'developer') {
                removeModule(remove.dataset.removeModule);
                selectedModuleIds = selectedModuleIds.filter(function (id) { return findModule(id); });
                if (!findModule(selectedId)) selectedId = null;
                refresh();
                return;
            }

            var edit = event.target.closest('[data-edit-module]');
            if (edit && mode === 'developer') {
                selectedId = edit.dataset.editModule;
                selectedModuleIds = [];
                refresh();
                return;
            }

            var addModifier = event.target.closest('[data-add-modifier]');
            if (addModifier) {
                var targetModule = findModule(addModifier.dataset.addModifier);
                if (targetModule) {
                    targetModule.modifiers.push({ source: checkboxModules()[0] ? checkboxModules()[0].id : '', amount: -1 });
                    selectedId = targetModule.id;
                    refresh();
                }
                return;
            }

            var removeModifier = event.target.closest('[data-remove-modifier]');
            if (removeModifier) {
                var modifierRow = removeModifier.closest('[data-modifier-index]');
                var modifierModule = findModule(modifierRow.dataset.moduleId);
                if (modifierModule) {
                    modifierModule.modifiers.splice(Number(modifierRow.dataset.modifierIndex), 1);
                    selectedId = modifierModule.id;
                    refresh();
                }
                return;
            }

            var roll = event.target.closest('[data-roll-module]');
            if (roll) {
                var dice = findModule(roll.dataset.rollModule);
                var count = diceCount(dice);
                var sides = diceSides(dice);
                var keepHighest = diceKeepHighest(dice);
                var rolls = [];
                for (var index = 0; index < count; index += 1) rolls.push(Math.floor(Math.random() * sides) + 1);
                var kept = keepHighest ? rolls.slice().sort(function (first, second) { return second - first; }).slice(0, keepHighest) : rolls;
                var rollTotal = kept.reduce(function (total, value) { return total + value; }, 0);
                var bonus = diceBonus(dice);
                var total = rollTotal + bonus;
                var result = keepHighest ? 'Rolls: ' + rolls.join(', ') + ' (kept ' + kept.join(', ') + ')' : rolls.join(' + ');
                if (bonus) result += (bonus > 0 ? ' + ' : ' ') + bonus;
                if (!keepHighest && !bonus && rolls.length === 1) {
                    dice.rollResult = String(total);
                } else {
                    dice.rollResult = result + ' = ' + total;
                }
                renderCanvas();
                return;
            }
        });

        function syncControl(event) {
            var moduleInput = event.target.closest('[data-module-value]');
            if (moduleInput && event.type === 'input') {
                var inputModule = findModule(moduleInput.dataset.moduleValue);
                if (inputModule) inputModule.value = moduleInput.value;
                updateLiveValues();
            }

            if (event.type === 'change') {
                var checkbox = event.target.closest('[data-module-checked]');
                if (checkbox) {
                    var checkboxModule = findModule(checkbox.dataset.moduleChecked);
                    if (checkboxModule) checkboxModule.checked = checkbox.checked;
                    updateLiveValues();
                }
            }

            var isSelect = event.target.tagName === 'SELECT';
            var syncValue = event.type === 'input' ? !isSelect : isSelect;
            var setting = event.target.dataset.setting;
            if (setting && mode === 'developer' && syncValue) {
                updateSetting(event.target, setting);
            }

            var modifierSetting = event.target.dataset.modifierSetting;
            if (modifierSetting && syncValue) {
                updateModifier(event.target, modifierSetting);
            }
        }

        studio.addEventListener('input', syncControl);
        studio.addEventListener('change', syncControl);

        // update selected module settings
        function updateSetting(control, setting) {
            var module = findModule(selectedId);
            if (!module) return;
            module[setting] = numericSettings.includes(setting) ? Number(control.value) : control.value;
            if (setting === 'name') {
                var header = studio.querySelector('[data-sheet-module="' + module.id + '"] [data-module-title]');
                if (header) {
                    header.textContent = module.name || names[module.type];
                    header.parentElement.querySelector('[data-move-module]').setAttribute('aria-label', 'Move ' + module.name);
                }
                updateLiveValues();
                return;
            }
            if (numericSettings.includes(setting)) {
                updateLiveValues();
                return;
            }
            if (setting === 'source' || setting === 'countSource' || setting === 'sidesSource' || setting === 'keepHighestSource' || setting === 'bonusSource') module.rollResult = '';
            refresh();
        }

        // update module checkbox modifier
        function updateModifier(control, setting) {
            var row = control.closest('[data-modifier-index]');
            var module = findModule(row.dataset.moduleId);
            var modifier = module && module.modifiers[Number(row.dataset.modifierIndex)];
            if (!modifier) return;
            modifier[setting] = setting === 'amount' ? Number(control.value) : control.value;
            updateLiveValues();
        }

        studio.querySelector('#sheet-name').addEventListener('input', function (event) {
            if (mode === 'playtest') studio.querySelector('[data-workspace-title]').textContent = event.target.value || 'Character sheet';
        });

        refresh();
    })();
</script>