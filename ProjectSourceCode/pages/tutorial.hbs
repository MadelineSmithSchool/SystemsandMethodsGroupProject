<main class="tutorial">
  <section class="intro">
    <div class="intro-text">
    <div class="controls" aria-label="Tutorial controls">
      <span class="progress-label" id="progress-label">Step 1 of 8</span>
      <span class="progress-bar" aria-hidden="true"><span class="progress-fill" id="progress-fill"></span></span>
      <button type="button" class="btn" id="prev-step" disabled>Previous</button>
      <button type="button" class="btn" id="next-step">Next</button>
    </div>
  </section>

  <div class="track" id="steps-track" tabindex="0" role="region" aria-label="Dashboard tutorial steps">
    <ol class="steps">

    <li class="step" aria-label="Step 1 of 8">
      <span class="step-token" aria-hidden="true">1</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-1.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 1">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Open your dashboard</h2>
        <p>Open a character and select the Dashboard tab. This board holds everything you track during play, with one card for each thing.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 2 of 8">
      <span class="step-token" aria-hidden="true">2</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-2.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 2">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Turn on edit mode</h2>
        <p>Select Edit layout in the top right of the dashboard. Every card gets a drag handle and a remove button so you can rearrange the board.</p>
      </article>
    </li>

  
    <li class="step" aria-label="Step 3 of 8">
      <span class="step-token" aria-hidden="true">3</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-3.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 3">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Open the card library</h2>
        <p>Select Add card. The library lists the prebuilt cards, such as Health, Status and Skills, along with any custom cards you have made.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 4 of 8">
      <span class="step-token" aria-hidden="true">4</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-4.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 4">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Add a prebuilt card</h2>
        <p>Pick a card, then select Add to dashboard. It lands in the first open space and starts with your character&rsquo;s current values.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 5 of 8">
      <span class="step-token" aria-hidden="true">5</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-5.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 5">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Pull in your skills</h2>
        <p>The Skills card fills itself from the game data, so you never type a skill by hand. Choose which skills to show and the card stays in sync with your character.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 6 of 8">
      <span class="step-token" aria-hidden="true">6</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-6.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 6">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Build your own card</h2>
        <p>Select Create custom card to track something the prebuilt cards don&rsquo;t, like spell slots or inspiration. Name the card, choose a field type (number, checkbox or text), then save it.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 7 of 8">
      <span class="step-token" aria-hidden="true">7</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-7.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 7">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Move and resize cards</h2>
        <p>Drag a card by its handle to move it. Drag a corner to resize it. The other cards shift to make room.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 8 of 8">
      <span class="step-token" aria-hidden="true">8</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-8.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 8">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Save your layout</h2>
        <p>Select Done to leave edit mode and save the layout. The next time you open this character, the board looks the way you left it.</p>
      </article>
    </li>
    </ol>
  </div>
</main>

<script>
  (function () {
    var track = document.getElementById('steps-track');
    var cards = Array.prototype.slice.call(track.querySelectorAll('.step'));
    var prev = document.getElementById('prev-step');
    var next = document.getElementById('next-step');
    var label = document.getElementById('progress-label');
    var fill = document.getElementById('progress-fill');
    var total = cards.length;

    function padding() {
      return parseFloat(getComputedStyle(track.querySelector('.steps')).paddingLeft) || 0;
    }

    function currentIndex() {
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) return total - 1;
      var edge = track.getBoundingClientRect().left + padding();
      var best = 0, bestDistance = Infinity;
      cards.forEach(function (card, i) {
        var d = Math.abs(card.getBoundingClientRect().left - edge);
        if (d < bestDistance) { bestDistance = d; best = i; }
      });
      return best;
    }

    function goTo(index) {
      var i = Math.max(0, Math.min(total - 1, index));
      track.scrollTo({
        left: cards[i].getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft - padding()
      });
    }

    function update() {
      var i = currentIndex();
      label.textContent = 'Step ' + (i + 1) + ' of ' + total;
      fill.style.width = ((i + 1) / total) * 100 + '%';
      prev.disabled = i === 0;
      next.disabled = i === total - 1;
    }

    var ticking = false;
    track.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { update(); ticking = false; });
    });
    prev.addEventListener('click', function () { goTo(currentIndex() - 1); });
    next.addEventListener('click', function () { goTo(currentIndex() + 1); });
    window.addEventListener('resize', update);

    track.scrollLeft = 0;
    update();
  })();
</script>