<main class="tutorial">
  <section class="intro">
    <div class="intro-text">
      <h1>How to set up a template</h1>
      <p>Choose a starting option on the dashboard, then build and test a reusable character sheet in the RPG Templates Studio.</p>
    </div>
    <div class="controls" aria-label="Tutorial controls">
      <span class="progress-label" id="progress-label">Step 1 of 10</span>
      <span class="progress-bar" aria-hidden="true"><span class="progress-fill" id="progress-fill"></span></span>
      <button type="button" class="btn" id="prev-step" disabled>Previous</button>
      <button type="button" class="btn" id="next-step">Next</button>
    </div>
  </section>

  <div class="track" id="steps-track" tabindex="0" role="region" aria-label="Dashboard tutorial steps">
    <ol class="steps">

    <li class="step" aria-label="Step 1 of 10">
      <span class="step-token" aria-hidden="true">1</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-1.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 1">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <img src="\images\dashboardss1.png" alt="screenshot of dashboard page">
          </div>
        </div>
        <h2>Choose how to begin</h2>
        <p>On the dashboard, choose <strong>Upload a Template</strong>, <strong>Template Library</strong>, or <strong>Build From Scratch</strong>. Your choice depends on whether you already have a JSON file, want to reopen a saved sheet, or are starting a new design.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 2 of 10">
      <span class="step-token" aria-hidden="true">2</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-2.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 2">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <img src="\images\uploadss2.png" alt="screenshot of uploads page with a tutorial.json being uploaded from users downloads">
          </div>
        </div>
        <h2>Upload an existing template</h2>
        <p>Select <strong>Upload a Template</strong> when you have a compatible .json file. On the upload page, choose the file and select <strong>Upload</strong>. The studio then opens the uploaded sheet so you can review and edit it.</p>
      </article>
    </li>

  
    <li class="step" aria-label="Step 3 of 10">
      <span class="step-token" aria-hidden="true">3</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-3.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 3">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Open an owned or saved template</h2>
        <p>Select <strong>Template Library</strong> to see templates you created or saved to your library. Open a template from the list to view it; templates you own have an <strong>Edit</strong> button that opens the studio.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 4 of 10">
      <span class="step-token" aria-hidden="true">4</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-4.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 4">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <img src="\images\newTemplatess4.png" alt="screenshot of dashboard page">
          </div>
        </div>
        <h2>Start from a blank sheet</h2>
        <p>Select <strong>Build From Scratch</strong> when you do not have a file or saved template to reuse. The studio opens with an empty canvas, ready for you to add modules and arrange the sheet.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 5 of 10">
      <span class="step-token" aria-hidden="true">5</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-5.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 5">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Switch between Developer and Playtest</h2>
        <p>Use <strong>Developer</strong> to edit the layout and settings. Use <strong>Playtest</strong> to interact with the sheet as a player, enter values, and test calculations or rolls.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 6 of 10">
      <span class="step-token" aria-hidden="true">6</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-6.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 6">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Set up sheets and canvases</h2>
        <p>Open <strong>Sheet settings</strong> to name the canvas, set its grid square size, and change canvas, header, module, input, and accent colors. Select <strong>Add canvas</strong> for another tabbed area. Select a top-level module, choose a destination, and use <strong>Move module</strong> to move it.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 7 of 10">
      <span class="step-token" aria-hidden="true">7</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-7.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 7">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span></span>
          </div>
        </div>
        <h2>Add modules from the palette</h2>
        <p>Click a palette button or drag it onto the canvas. <strong>Number</strong>, <strong>Text</strong>, <strong>Dice</strong>, <strong>Checkbox</strong>, and <strong>Notes</strong> handle common values. <strong>Math</strong> calculates values, <strong>Pages</strong> creates tabbed sections, <strong>Group</strong> organizes fields, and <strong>List</strong> creates repeatable rows.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 8 of 10">
      <span class="step-token" aria-hidden="true">8</span>
      <article class="card">
        <div class="shot">
          <!-- To add a screenshot, delete the placeholder below and use:
               <img src="/images/tutorial/step-8.png" alt="Describe the screenshot"> -->
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 8">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <img src="\images\newTemplatess10.png" alt="screenshot of module edit area">
          </div>
        </div>
        <h2>Configure and arrange modules</h2>
        <p>Select a module, then use <strong>Edit</strong> or <strong>Module settings</strong> to change its name, size, position, source, and other options. Drag modules to reposition them. Use a module&rsquo;s remove control to delete it. Drag a rectangle across the canvas to select several modules at once.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 9 of 10">
      <span class="step-token" aria-hidden="true">9</span>
      <article class="card">
        <div class="shot">
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 9">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Reuse a module preset</h2>
        <p>Load <strong>Ability check</strong>, <strong>Advantage attack</strong>, or <strong>Ability Score Bonus</strong> for connected, ready-made module setups. To create your own preset, select a group of modules, enter a preset name, and select <strong>Save selected modules</strong>.</p>
      </article>
    </li>

    <li class="step" aria-label="Step 10 of 10">
      <span class="step-token" aria-hidden="true">10</span>
      <article class="card">
        <div class="shot">
          <div class="shot-empty" role="img" aria-label="Screenshot placeholder for step 10">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.75"></circle><path d="M21 16l-5-5-8 9"></path></svg>
            <span>Screenshot goes here</span>
          </div>
        </div>
        <h2>Test, download, or save</h2>
        <p><strong>Playtest</strong> verifies the finished experience. <strong>Download .json</strong> opens a naming dialog, updates the template name, and exports a copy to your computer. <strong>Save</strong> stores the template and asks for a title, description, and level: <strong>Private</strong> for only you, <strong>Public</strong> for public discovery, or <strong>Unlisted</strong> for access by link.</p>
      </article>
    </li>
    </ol>
  </div>
</main>

<script>
  (function () {
    var track = document.getElementById('steps-track');
    var cards = Array.prototype.slice.call(track.querySelectorAll('.step'));
    var prev = document.getElementById('prev-step');
    var next = document.getElementById('next-step');
    var label = document.getElementById('progress-label');
    var fill = document.getElementById('progress-fill');
    var total = cards.length;

    function padding() {
      return parseFloat(getComputedStyle(track.querySelector('.steps')).paddingLeft) || 0;
    }

    function currentIndex() {
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) return total - 1;
      var edge = track.getBoundingClientRect().left + padding();
      var best = 0, bestDistance = Infinity;
      cards.forEach(function (card, i) {
        var d = Math.abs(card.getBoundingClientRect().left - edge);
        if (d < bestDistance) { bestDistance = d; best = i; }
      });
      return best;
    }

    function goTo(index) {
      var i = Math.max(0, Math.min(total - 1, index));
      track.scrollTo({
        left: cards[i].getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft - padding()
      });
    }

    function update() {
      var i = currentIndex();
      label.textContent = 'Step ' + (i + 1) + ' of ' + total;
      fill.style.width = ((i + 1) / total) * 100 + '%';
      prev.disabled = i === 0;
      next.disabled = i === total - 1;
    }

    var ticking = false;
    track.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { update(); ticking = false; });
    });
    prev.addEventListener('click', function () { goTo(currentIndex() - 1); });
    next.addEventListener('click', function () { goTo(currentIndex() + 1); });
    window.addEventListener('resize', update);

    track.scrollLeft = 0;
    update();
  })();
</script>