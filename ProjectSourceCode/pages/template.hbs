<!-- Shows one uploaded template. Placeholder until the dashboard page can display templates. -->
<main class="container my-4">
    <h2>{{template.name}}</h2>
    {{#if template.data.description}}
        <p class="text-muted">{{template.data.description}}</p>
    {{/if}}

    {{> template-stats template=template}}

    <a href="/templates/{{template.id}}/share" class="btn btn-primary">Send</a>
    <a href="/templates/upload" class="btn btn-outline-secondary">Upload another</a>
</main>
