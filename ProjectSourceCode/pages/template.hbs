<main class="sheet-studio" data-sheet-studio data-player-sheet data-mode="playtest"
    data-player-storage-key="character-sheet-{{template.template_id}}"
    data-initial-template="{{initialTemplate}}">
    <header class="studio-header">
        <div class="player-sheet-meta">
            <div>
                <span class="player-sheet-label">Title</span>
                <h1>{{template.template_name}}</h1>
            </div>
            <div>
                <span class="player-sheet-label">Description</span>
                <p class="studio-subtitle">{{#if template.template_desc}}{{template.template_desc}}{{else}}No description provided.{{/if}}</p>
            </div>
        </div>
        <div class="player-sheet-header" style="margin-top:30px">
            {{#if template.is_owner}}
                <a href="/edit/{{template.template_id}}" class="btn btn--primary">Edit</a>
                <button type="button" class="btn btn--danger" data-open-template-delete>Delete</button>
            {{/if}}
            <a href="/characters/create?templateId={{template.template_id}}" class="btn btn--sm">Create Character</a>
            <div class="player-sheet-saves">
                <strong>{{template.times_saved}}</strong>
                <span>times saved</span>
            </div>
        </div>
    </header>

    {{#if template.is_owner}}
        <dialog class="template-share-dialog" data-template-delete-dialog aria-labelledby="template-delete-dialog-title">
            <div>
                <h2 id="template-delete-dialog-title">Delete {{template.template_name}}?</h2>
                <p>This permanently deletes the template and removes it from all libraries. Existing characters will remain but will no longer be linked to it.</p>
                <div class="template-card-actions">
                    <form action="/templates/{{template.template_id}}/delete" method="POST">
                        <button type="submit" class="btn btn--danger">Delete template</button>
                    </form>
                    <button type="button" class="btn btn--sm" data-close-template-delete>Cancel</button>
                </div>
            </div>
        </dialog>
        <script>
            (function () {
                var dialog = document.querySelector('[data-template-delete-dialog]');
                document.querySelector('[data-open-template-delete]').addEventListener('click', function () {
                    dialog.showModal();
                });
                document.querySelector('[data-close-template-delete]').addEventListener('click', function () {
                    dialog.close();
                });
            }());
        </script>
    {{/if}}

    <div class="studio-layout">
        <section class="studio-workspace" aria-label="Character sheet">
            <p class="studio-muted">Double-click a field (or press Enter or F2) to edit, then tab away to finish. Linked values are underlined.</p>
            <div class="canvas-tabs pages-tabs" data-canvas-tabs role="tablist" aria-label="Canvases" hidden></div>
            <div id="sheet-canvas" class="studio-canvas" data-layout-canvas data-root-canvas role="region" aria-label="Character sheet" tabindex="0">
                <p class="canvas-empty-state" data-empty-state>No character sheet modules to display.</p>
            </div>
        </section>
    </div>
</main>

<script type="module" src="/js/modules-main.js"></script>
