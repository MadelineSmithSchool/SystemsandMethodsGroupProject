<main class="sheet-studio" data-sheet-studio data-player-sheet data-mode="playtest"
    data-player-storage-key="character-sheet-{{template.template_id}}"
    data-initial-template="{{initialTemplate}}">
    <header class="studio-header">
        <div class="player-sheet-meta">
            <div>
                <span class="player-sheet-label">Title</span>
                <h1>{{template.template_name}}</h1>
            </div>
            <div>
                <span class="player-sheet-label">Description</span>
                <p class="studio-subtitle">{{#if template.template_desc}}{{template.template_desc}}{{else}}No description provided.{{/if}}</p>
            </div>
        </div>
        <div class="player-sheet-header-side">
            {{#if template.is_owner}}
                <a href="/edit/{{template.template_id}}" class="btn btn--primary">Edit</a>
            {{/if}}
            <div class="player-sheet-saves">
                <strong>{{template.times_saved}}</strong>
                <span>times saved</span>
            </div>
        </div>
    </header>

    <div class="studio-layout">
        <section class="studio-workspace" aria-label="Character sheet">
            <div class="studio-canvas" data-layout-canvas data-root-canvas role="region" aria-label="Character sheet" tabindex="0">
                <p class="canvas-empty-state" data-empty-state>No character sheet modules to display.</p>
            </div>
        </section>
    </div>
</main>

<script type="module" src="/js/modules-main.js"></script>
