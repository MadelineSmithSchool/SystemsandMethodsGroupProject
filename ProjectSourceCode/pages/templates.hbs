{{#if sharedTemplate}}
    <main class="templates-page">
        <header class="templates-page-header">
            <div>
                <h1>Shared template</h1>
                <p>Someone sent you a template.</p>
            </div>
        </header>
        <article class="template-card shared-template-card">
            <h2>{{sharedTemplate.template_name}}</h2>
            {{#if sharedTemplate.template_desc}}
                <p class="template-card-description">{{sharedTemplate.template_desc}}</p>
            {{/if}}
            {{> template-stats template=sharedTemplate}}
            <div class="template-card-actions">
                <form action="/templates/shared/{{sharedTemplate.share_id}}/save" method="POST">
                    <button type="submit" class="btn btn--primary">Save to my templates</button>
                </form>
                <a href="/templates/shared/{{sharedTemplate.share_id}}/download" class="btn btn--sm">Download</a>
            </div>
        </article>
    </main>
{{else}}
    <main class="templates-page">
        <header class="templates-page-header">
            <div>
                <h1>Your templates</h1>
                <p>Templates you have created, and saved.</p>
            </div>
            <a href="/templates/upload" class="btn btn--primary">Upload a template</a>
        </header>

        <section class="templates-grid" aria-label="Your templates">
            {{#each templates}}
                <article class="template-card">
                    <h2><a href="/templates/{{template_id}}">{{template_name}}</a></h2>
                    {{#if template_desc}}
                        <p class="template-card-description">{{template_desc}}</p>
                    {{/if}}
                    <dl class="template-card-details">
                        <div>
                            <dt>Creator</dt>
                            <dd>{{creator_name}}</dd>
                        </div>
                        <div>
                            <dt>Created</dt>
                            <dd>{{created_date}}</dd>
                        </div>
                    </dl>
                    <div class="template-card-actions">
                        <a href="/templates/{{template_id}}" class="template-card-open">View template</a>
                        {{#if is_owner}}
                            <a href="/templates/{{template_id}}/share" class="btn btn--sm">Share</a>
                        {{/if}}
                    </div>
                </article>
            {{else}}
                <p class="templates-empty">No templates yet. Upload a template or build one from scratch to get started.</p>
            {{/each}}
        </section>
    </main>

    {{#if shareLink}}
        <dialog class="template-share-dialog" data-template-share-dialog aria-labelledby="share-dialog-title">
            <div>
                <h2 id="share-dialog-title">Share {{shareTemplateName}}</h2>
                <p>Anyone with this link can view and download this template.</p>
                <label for="template-share-link">Share link</label>
                <div class="template-share-link-row">
                    <input id="template-share-link" type="text" value="{{shareLink}}" readonly>
                    <button class="btn btn--primary" type="button" data-copy-share-link>Copy link</button>
                </div>
                <p class="template-share-status" data-share-status role="status" aria-live="polite"></p>
                <a class="btn btn--sm" href="/templates">Close</a>
            </div>
        </dialog>
        <script>
            (function () {
                var dialog = document.querySelector('[data-template-share-dialog]');
                var link = document.querySelector('#template-share-link');
                var status = document.querySelector('[data-share-status]');
                dialog.showModal();
                document.querySelector('[data-copy-share-link]').addEventListener('click', async function () {
                    try {
                        await navigator.clipboard.writeText(link.value);
                        status.textContent = 'Link copied.';
                    } catch (error) {
                        link.select();
                        status.textContent = 'Copy is unavailable. The link is selected so you can copy it.';
                    }
                });
            }());
        </script>
    {{/if}}
{{/if}}
