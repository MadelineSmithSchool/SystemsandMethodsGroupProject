<h1>Template Library</h1>
{{#if error}}<p class="error">{{error}}</p>{{/if}}
{{> list-controls action="/library" label="Search the template library" placeholder="Name, description, or creator"}}
<div class="template-list">
  {{#each templates}}
    <div class="card">
      <h3>{{this.template_name}}</h3>
      <p>{{this.template_desc}}</p>
      {{#if this.creator}}<small>by {{this.creator}}</small>{{/if}}
      <small>{{this.saves_label}}</small>
    </div>
  {{else}}
    {{#if list.search}}
      <p>No public templates match "{{list.search}}".</p>
    {{else}}
      <p>No public templates yet.</p>
    {{/if}}
  {{/each}}
</div>
