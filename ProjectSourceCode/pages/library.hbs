<main class="templates-page">
  <h1>Browse Templates</h1>
  {{#if error}}<p class="error" data-list-error>{{error}}</p>{{/if}}
  {{> list-controls action="/library" label="Search public templates" placeholder="Name, description, or creator"}}
  <div class="templates-grid" data-list-results>
    {{#each templates}}
      <article class="template-card" data-list-item>
          <h2><a href="/templates/{{template_id}}">{{template_name}}</a></h2>
          {{#if template_desc}}
              <p class="template-card-description">{{template_desc}}</p>
          {{/if}}
          <dl class="template-card-details">
              <div>
                  <dt>Creator</dt>
                  <dd>{{creator_name}}</dd>
              </div>
              <div>
                  <dt>Created</dt>
                  <dd>{{created_date}}</dd>
              </div>
              <div>
                  <dt>Saves</dt>
                  <dd>{{times_saved}}</dd>
              </div>
          </dl>
          <div class="template-card-actions">
              <a href="/templates/{{template_id}}" class="template-card-open">View template</a>
              {{#if is_owner}}
                  <a href="/edit/{{template_id}}" class="btn btn--sm">Edit</a>
                  <a href="/templates/{{template_id}}/share" class="btn btn--sm">Share</a>
              {{/if}}
          </div>
      </article>
    {{else}}
      {{#if list.search}}
        <p class="templates-empty">No public templates match "{{list.search}}".</p>
      {{else}}
        <p class="templates-empty">No public templates yet.</p>
      {{/if}}
    {{/each}}
  </div>
</main>
