<main class="container my-4" style="max-width: 540px;">
    <h2>Upload a template</h2>
    <p class="text-muted">Pick a template file (.json) from your computer.</p>

    {{#if error}}
        <div class="alert alert-danger" role="alert">{{error}}</div>
    {{/if}}

    <form action="/templates/upload" method="POST" enctype="multipart/form-data">
        <input class="form-control mb-3" type="file" name="template" accept=".json" required>
        <button type="submit" class="btn btn-primary">Upload</button>
    </form>
</main>
