<header class="site-header">
  <a class="brand" href="/">RPG Templates</a>
  <nav class="navbar" aria-label="Main">
    {{#if admin}}
      <ul class="nav-list">
        <li><form action="/manage" method="GET"><input class="form-control" type="search" name="users" value="{{userSearch}}" aria-label="User search" placeholder="Search users"></form></li>
        <li><form action="/manage" method="GET"><input class="form-control" type="search" name="templates" value="{{templateSearch}}" aria-label="Library search" placeholder="Search library"></form></li>
        <li><a href="/logout">Logout</a></li>
      </ul>
    {{else if login}}
      <ul class="nav-list">
        <li><a href="/tutorial">Tutorial</a></li>
        <li class="nav-dropdown">
          <details>
            {{!-- change this to image maybe or icon --}}
            <summary>Navigation</summary> 
            <ul class="nav-dropdown-menu">
              <li><a href="/dashboard">Open Dashboard</a></li>
              <li><a href="/templates/new">Build Template From Scratch</a></li>
              <li><a href="/templates">My Templates</a></li>
              <li><a href="/library">Browse Templates</a></li>
              <li><a href="/characters">My Characters</a></li>
              <li><a href="/characters/new">Create New Character</a></li>
              {{#if user.admin}}<li><a href="/manage">Admin</a></li>{{/if}}
            </ul>
          </details>
        </li>
        <li><a href="/logout">Log out</a></li>
      </ul>
    {{else}}
      <ul class="nav-list">
        <li><a href="/login">Login</a></li>
        <li><a href="/register">Register</a></li>
      </ul>
    {{/if}}
  </nav>
</header>

<script>
  (function () {
    var here = location.pathname.replace(/\/+$/, '') || '/';
    document.querySelectorAll('.nav-list a').forEach(function (a) {
      var href = a.getAttribute('href');
      if (!href || href.charAt(0) === '#') return;
      var target = new URL(href, window.location.href);
      var targetPath = target.pathname.replace(/\/+$/, '') || '/';
      if (targetPath === here && target.search === location.search) {
        a.setAttribute('aria-current', 'page');
      }
    });
  })();
</script>