<header class="site-header">
  <a class="brand" href="/">RPG Templates</a>
  <nav class="navbar" aria-label="Main">
    {{#if admin}}
      <ul class="nav-list">
        <li><input class="form-control" type="search" aria-label="User search" placeholder="Search users"></li>
        <li><input class="form-control" type="search" aria-label="Library search" placeholder="Search library"></li>
      </ul>
    {{else if login}}
      <ul class="nav-list">
        <li><a href="/tutorial">Tutorial</a></li>
        <li class="nav-dropdown">
          <details>
            <summary>Dashboard</summary>
            <ul class="nav-dropdown-menu">
              <li><a href="/dashboard">Open dashboard</a></li>
              <li><a href="/templates/upload">Upload a template</a></li>
              <li><a href="/dashboard?start=scratch">Build from scratch</a></li>
              <li><a href="/dashboard?start=template">Build from a template</a></li>
              <li><a href="/dashboard?start=previous">Work on a previous template</a></li>
              <li><a href="/templates/new">Build a new template</a></li>
              <li><a href="/templates">My templates</a></li>
            </ul>
          </details>
        </li>
        <li><a href="/logout">Log out</a></li>
      </ul>
    {{else}}
      <ul class="nav-list">
        <li><a href="/login">Login</a></li>
        <li><a href="/register">Register</a></li>
      </ul>
    {{/if}}
  </nav>
</header>

<script>
  // Marks the nav link that matches the current URL, so every page highlights the right item.
  (function () {
    var here = location.pathname.replace(/\/+$/, '') || '/';
    document.querySelectorAll('.nav-list a').forEach(function (a) {
      var href = a.getAttribute('href');
      if (!href || href.charAt(0) === '#') return;
      var target = new URL(href, window.location.href);
      var targetPath = target.pathname.replace(/\/+$/, '') || '/';
      if (targetPath === here && target.search === location.search) {
        a.setAttribute('aria-current', 'page');
        var dropdown = a.closest('.nav-dropdown');
        if (dropdown) {
          dropdown.querySelector('details').open = true;
          dropdown.querySelector('summary').setAttribute('aria-current', 'page');
        }
      }
    });
  })();
</script>